syntax = "proto3";

package sharkbuf_unittest;


import "shark/any.shark";
import "shark/api.shark";
import "shark/duration.shark";
import "shark/empty.shark";
import "shark/field_mask.shark";
import "shark/source_context.shark";
import "shark/struct.shark";
import "shark/timestamp.shark";
import "shark/type.shark";
import "shark/wrappers.shark";

// Test that we can include all well-known types.
// Each wrapper type is included separately, as languages
// map handle different wrappers in different ways.
message TestWellKnownTypes {
  shark.Any any_field = 1;
  shark.Api api_field = 2;
  shark.Duration duration_field = 3;
  shark.Empty empty_field = 4;
  shark.FieldMask field_mask_field = 5;
  shark.SourceContext source_context_field = 6;
  shark.Struct struct_field = 7;
  shark.Timestamp timestamp_field = 8;
  shark.Type type_field = 9;
  shark.DoubleValue double_field = 10;
  shark.FloatValue float_field = 11;
  shark.Int64Value int64_field = 12;
  shark.UInt64Value uint64_field = 13;
  shark.Int32Value int32_field = 14;
  shark.UInt32Value uint32_field = 15;
  shark.BoolValue bool_field = 16;
  shark.StringValue string_field = 17;
  shark.BytesValue bytes_field = 18;
  // Part of struct, but useful to be able to test separately
  shark.Value value_field = 19;
}

// A repeated field for each well-known type.
message RepeatedWellKnownTypes {
  repeated shark.Any any_field = 1;
  repeated shark.Api api_field = 2;
  repeated shark.Duration duration_field = 3;
  repeated shark.Empty empty_field = 4;
  repeated shark.FieldMask field_mask_field = 5;
  repeated shark.SourceContext source_context_field = 6;
  repeated shark.Struct struct_field = 7;
  repeated shark.Timestamp timestamp_field = 8;
  repeated shark.Type type_field = 9;
  // These don't actually make a lot of sense, but they're not prohibited...
  repeated shark.DoubleValue double_field = 10;
  repeated shark.FloatValue float_field = 11;
  repeated shark.Int64Value int64_field = 12;
  repeated shark.UInt64Value uint64_field = 13;
  repeated shark.Int32Value int32_field = 14;
  repeated shark.UInt32Value uint32_field = 15;
  repeated shark.BoolValue bool_field = 16;
  repeated shark.StringValue string_field = 17;
  repeated shark.BytesValue bytes_field = 18;
}

message OneofWellKnownTypes {
  oneof oneof_field {
    shark.Any any_field = 1;
    shark.Api api_field = 2;
    shark.Duration duration_field = 3;
    shark.Empty empty_field = 4;
    shark.FieldMask field_mask_field = 5;
    shark.SourceContext source_context_field = 6;
    shark.Struct struct_field = 7;
    shark.Timestamp timestamp_field = 8;
    shark.Type type_field = 9;
    shark.DoubleValue double_field = 10;
    shark.FloatValue float_field = 11;
    shark.Int64Value int64_field = 12;
    shark.UInt64Value uint64_field = 13;
    shark.Int32Value int32_field = 14;
    shark.UInt32Value uint32_field = 15;
    shark.BoolValue bool_field = 16;
    shark.StringValue string_field = 17;
    shark.BytesValue bytes_field = 18;
  }
}

// A map field for each well-known type. We only
// need to worry about the value part of the map being the
// well-known types, as messages can't be map keys.
message MapWellKnownTypes {
  map<int32,shark.Any> any_field = 1;
  map<int32,shark.Api> api_field = 2;
  map<int32,shark.Duration> duration_field = 3;
  map<int32,shark.Empty> empty_field = 4;
  map<int32,shark.FieldMask> field_mask_field = 5;
  map<int32,shark.SourceContext> source_context_field = 6;
  map<int32,shark.Struct> struct_field = 7;
  map<int32,shark.Timestamp> timestamp_field = 8;
  map<int32,shark.Type> type_field = 9;
  map<int32,shark.DoubleValue> double_field = 10;
  map<int32,shark.FloatValue> float_field = 11;
  map<int32,shark.Int64Value> int64_field = 12;
  map<int32,shark.UInt64Value> uint64_field = 13;
  map<int32,shark.Int32Value> int32_field = 14;
  map<int32,shark.UInt32Value> uint32_field = 15;
  map<int32,shark.BoolValue> bool_field = 16;
  map<int32,shark.StringValue> string_field = 17;
  map<int32,shark.BytesValue> bytes_field = 18;
}
