syntax = "proto2";

package proto_util_converter.testing;

import "shark/types/any.shark";

// Top-level test cases proto used by MarshallingTest. See description
// at the top of the class MarshallingTest for details on how to write
// test cases.
message MapsTestCases {
  optional EmptyMap empty_map = 1;
  optional StringtoInt string_to_int = 2;
  optional IntToString int_to_string = 3;
  optional Mixed1 mixed1 = 4;
  optional Mixed2 mixed2 = 5;
  optional MapOfObjects map_of_objects = 6;

  // Empty key tests
  optional StringtoInt empty_key_string_to_int1 = 7;
  optional StringtoInt empty_key_string_to_int2 = 8;
  optional StringtoInt empty_key_string_to_int3 = 9;
  optional BoolToString empty_key_bool_to_string = 10;
  optional IntToString empty_key_int_to_string = 11;
  optional Mixed1 empty_key_mixed = 12;
  optional MapOfObjects empty_key_map_objects = 13;
}

message EmptyMap {
  map<int32, int32> map = 1;
}

message StringtoInt {
  map<string, int32> map = 1;
}

message IntToString {
  map<int32, string> map = 1;
}

message BoolToString {
  map<bool, string> map = 1;
}

message Mixed1 {
  optional string msg = 1;
  map<string, float> map = 2;
}

message Mixed2 {
  enum E {
    E0 = 0;
    E1 = 1;
    E2 = 2;
    E3 = 3;
  }
  map<int32, bool> map = 1;
  optional E ee = 2;
}

message MapOfObjects {
  message M {
    optional string inner_text = 1;
  }
  map<string, M> map = 1;
}

message DummyRequest {}

service MapsTestService {
  rpc Call(DummyRequest) returns (MapsTestCases);
}

message MapIn {
  optional string other = 1;
  list<string> things = 2;
  map<string, string> map_input = 3;
  map<string, shark.Any> map_any = 4;
}

message MapOut {
  map<string, MapM> map1 = 1;
  map<string, MapOut> map2 = 2;
  map<int32, string> map3 = 3;
  map<bool, string> map4 = 5;
  optional string bar = 4;
}

// A message with exactly the same wire representation as MapOut, but using
// list<message> fields instead of map fields. We use this message to test
// the wire-format compatibility of the JSON transcoder (e.g., whether it
// handles missing keys correctly).
message MapOutWireFormat {
  message Map1Entry {
    optional string key = 1;
    optional MapM value = 2;
  }
  list<Map1Entry> map1 = 1;
  message Map2Entry {
    optional string key = 1;
    optional MapOut value = 2;
  }
  list<Map2Entry> map2 = 2;
  message Map3Entry {
    optional int32 key = 1;
    optional string value = 2;
  }
  list<Map3Entry> map3 = 3;
  message Map4Entry {
    optional bool key = 1;
    optional string value = 2;
  }
  list<Map4Entry> map4 = 5;
  optional string bar = 4;
}

message MapM {
  optional string foo = 1;
}
