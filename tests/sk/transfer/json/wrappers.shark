syntax = "proto2";

package proto_util_converter.testing;

import "shark/types/wrappers.shark";

// Top-level test cases proto used by MarshallingTest. See description
// at the top of the class MarshallingTest for details on how to write
// test cases.
message WrappersTestCases {
  optional DoubleWrapper double_wrapper = 1;
  optional FloatWrapper float_wrapper = 2;
  optional Int64Wrapper int64_wrapper = 3;
  optional UInt64Wrapper uint64_wrapper = 4;
  optional Int32Wrapper int32_wrapper = 5;
  optional UInt32Wrapper uint32_wrapper = 6;
  optional BoolWrapper bool_wrapper = 7;
  optional StringWrapper string_wrapper = 8;
  optional BytesWrapper bytes_wrapper = 9;

  optional DoubleWrapper double_wrapper_default = 10;
  optional FloatWrapper float_wrapper_default = 11;
  optional Int64Wrapper int64_wrapper_default = 12;
  optional UInt64Wrapper uint64_wrapper_default = 13;
  optional Int32Wrapper int32_wrapper_default = 14;
  optional UInt32Wrapper uint32_wrapper_default = 15;
  optional BoolWrapper bool_wrapper_default = 16;
  optional StringWrapper string_wrapper_default = 17;
  optional BytesWrapper bytes_wrapper_default = 18;
}

message DoubleWrapper {
  optional shark.DoubleValue double = 1;
}

message FloatWrapper {
  optional shark.FloatValue float = 1;
}

message Int64Wrapper {
  optional shark.Int64Value int64 = 1;
}

message UInt64Wrapper {
  optional shark.UInt64Value uint64 = 1;
}

message Int32Wrapper {
  optional shark.Int32Value int32 = 1;
}

message UInt32Wrapper {
  optional shark.UInt32Value uint32 = 1;
}

message BoolWrapper {
  optional shark.BoolValue bool = 1;
}

message StringWrapper {
  optional shark.StringValue string = 1;
}

message BytesWrapper {
  optional shark.BytesValue bytes = 1;
}

service WrappersTestService {
  rpc Call(WrappersTestCases) returns (WrappersTestCases);
}
