syntax = "proto2";

package proto_util_converter.testing;

import "shark/types/struct.shark";

message StructTestCases {
  optional StructWrapper empty_value = 1;
  optional StructWrapper empty_value2 = 2;
  optional StructWrapper null_value = 3;
  optional StructWrapper simple_struct = 4;
  optional StructWrapper longer_struct = 5;
  optional StructWrapper struct_with_nested_struct = 6;
  optional StructWrapper struct_with_nested_list = 7;
  optional StructWrapper struct_with_list_of_nulls = 8;
  optional StructWrapper struct_with_list_of_lists = 9;
  optional StructWrapper struct_with_list_of_structs = 10;
  optional StructWrapper struct_with_empty_list = 11;
  optional StructWrapper struct_with_list_with_empty_struct = 12;
  optional shark.Struct top_level_struct = 13;
  optional shark.Struct top_level_struct_with_empty_list = 14;
  optional shark.Struct top_level_struct_with_list_with_empty_struct = 15;
  optional ValueWrapper value_wrapper_simple = 16;
  optional ValueWrapper value_wrapper_with_struct = 17;
  optional ValueWrapper value_wrapper_with_list = 18;
  optional ValueWrapper value_wrapper_with_empty_list = 19;
  optional ValueWrapper value_wrapper_with_list_with_empty_struct = 20;
  optional ListValueWrapper list_value_wrapper = 21;
  optional ListValueWrapper list_value_wrapper_with_empty_list = 22;
  optional ListValueWrapper list_value_wrapper_with_list_with_empty_struct = 23;
  optional shark.Value top_level_value_simple = 24;
  optional shark.Value top_level_value_with_struct = 25;
  optional shark.Value top_level_value_with_list = 26;
  optional shark.Value top_level_value_with_empty_list = 27;
  optional shark.Value top_level_value_with_list_with_empty_struct = 28;
  optional shark.ListValue top_level_listvalue = 29;
  optional shark.ListValue top_level_empty_listvalue = 30;
  optional shark.ListValue top_level_listvalue_with_empty_struct = 31;
  optional RepeatedValueWrapper repeated_value = 32;
  optional RepeatedValueWrapper repeated_value_nested_list = 33;
  optional RepeatedValueWrapper repeated_value_nested_list2 = 34;
  optional RepeatedValueWrapper repeated_value_nested_list3 = 35;
  optional RepeatedListValueWrapper repeated_listvalue = 36;
  optional MapOfStruct map_of_struct = 37;
  optional MapOfStruct map_of_struct_value = 38;
  optional MapOfStruct map_of_listvalue = 39;
}

message StructWrapper {
  optional shark.Struct struct = 1;
}

message ValueWrapper {
  optional shark.Value value = 1;
}

message RepeatedValueWrapper {
  list<shark.Value> values = 1;
}

message ListValueWrapper {
  optional shark.ListValue shopping_list = 1;
}

message RepeatedListValueWrapper {
  list<shark.ListValue> dimensions = 1;
}

message MapOfStruct {
  map<string, shark.Struct> struct_map = 1;
  map<string, shark.Value> value_map = 2;
  map<string, shark.ListValue> listvalue_map = 3;
}

// Hack to test return types with Struct as top-level message. Struct typers
// cannot be directly used in API requests. Hence using Dummy as request type.
message Dummy {
  optional string text = 1;
}

service StructTestService {
  rpc Call(Dummy) returns (StructTestCases);
}

message StructType {
  optional shark.Struct object = 1;
}
