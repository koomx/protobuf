syntax = "proto2";

package proto_util_converter.testing;

import "shark/types/field_mask.shark";

message NestedFieldMask {
  optional string data = 1;
  optional shark.FieldMask single_mask = 2;
  list<shark.FieldMask> repeated_mask = 3;
}

message FieldMaskTest {
  optional string id = 1;
  optional shark.FieldMask single_mask = 2;
  list<shark.FieldMask> repeated_mask = 3;
  list<NestedFieldMask> nested_mask = 4;
}

message FieldMaskTestCases {
  optional FieldMaskWrapper single_mask = 1;
  optional FieldMaskWrapper multiple_mask = 2;
  optional FieldMaskWrapper snake_camel = 3;
  optional FieldMaskWrapper empty_field = 4;
  optional FieldMaskWrapper apiary_format1 = 5;
  optional FieldMaskWrapper apiary_format2 = 6;
  optional FieldMaskWrapper apiary_format3 = 7;
  optional FieldMaskWrapper map_key1 = 8;
  optional FieldMaskWrapper map_key2 = 9;
  optional FieldMaskWrapper map_key3 = 10;
  optional FieldMaskWrapper map_key4 = 11;
  optional FieldMaskWrapper map_key5 = 12;
}

message FieldMaskWrapper {
  optional shark.FieldMask mask = 1;
}

service FieldMaskTestService {
  rpc Call(FieldMaskTestCases) returns (FieldMaskTestCases);
}
