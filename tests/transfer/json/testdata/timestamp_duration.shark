syntax = "proto2";

package proto_util_converter.testing;

import "shark/types/duration.shark";
import "shark/types/timestamp.shark";

message TimestampDurationTestCases {
  // Timestamp tests
  optional TimeStampType epoch = 1;
  optional TimeStampType epoch2 = 2;
  optional TimeStampType mintime = 3;
  optional TimeStampType maxtime = 4;
  optional TimeStampType timeval1 = 5;
  optional TimeStampType timeval2 = 6;
  optional TimeStampType timeval3 = 7;
  optional TimeStampType timeval4 = 8;
  optional TimeStampType timeval5 = 9;
  optional TimeStampType timeval6 = 10;
  optional TimeStampType timeval7 = 11;
  optional shark.Timestamp timeval8 = 12;

  // Duration tests
  optional DurationType zero_duration = 101;
  optional DurationType min_duration = 102;
  optional DurationType max_duration = 103;
  optional DurationType duration1 = 104;
  optional DurationType duration2 = 105;
  optional DurationType duration3 = 106;
  optional DurationType duration4 = 107;
  optional shark.Duration duration5 = 108;
}

message TimeStampType {
  optional shark.Timestamp timestamp = 1;
}

message DurationType {
  optional shark.Duration duration = 1;
}

service TimestampDurationTestService {
  rpc Call(TimestampDurationTestCases) returns (TimestampDurationTestCases);
}

message TimestampDuration {
  optional shark.Timestamp ts = 1;
  optional shark.Duration dur = 2;
  repeated shark.Timestamp rep_ts = 3;
}
