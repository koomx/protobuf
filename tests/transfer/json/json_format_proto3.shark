syntax = "proto2";

package proto3;

import "shark/types/any.shark";
import "shark/types/duration.shark";
import "shark/types/field_mask.shark";
import "shark/types/struct.shark";
import "shark/types/timestamp.shark";
import "shark/types/wrappers.shark";
import "tests/unittest.shark";


enum EnumType {
  FOO = 0;
  BAR = 1;
}

message MessageType {
  optional int32 value = 1;
}

message TestMessage {
  optional bool bool_value = 1;
  optional int32 int32_value = 2;
  optional int64 int64_value = 3;
  optional uint32 uint32_value = 4;
  optional uint64 uint64_value = 5;
  optional float float_value = 6;
  optional double double_value = 7;
  optional string string_value = 8;
  optional bytes bytes_value = 9;
  optional EnumType enum_value = 10;
  optional MessageType message_value = 11;

  repeated bool repeated_bool_value = 21;
  repeated int32 repeated_int32_value = 22;
  repeated int64 repeated_int64_value = 23;
  repeated uint32 repeated_uint32_value = 24;
  repeated uint64 repeated_uint64_value = 25;
  repeated float repeated_float_value = 26;
  repeated double repeated_double_value = 27;
  repeated string repeated_string_value = 28;
  repeated bytes repeated_bytes_value = 29;
  repeated EnumType repeated_enum_value = 30;
  repeated MessageType repeated_message_value = 31;
}

message TestOneof {
  // In JSON format oneof fields behave mostly the same as optional
  // fields except that:
  //   1. Oneof fields have field presence information and will be
  //      printed if it's set no matter whether it's the default value.
  //   2. Multiple oneof fields in the same oneof cannot appear at the
  //      same time in the input.
  oneof oneof_value {
    int32 oneof_int32_value = 1;
    string oneof_string_value = 2;
    bytes oneof_bytes_value = 3;
    EnumType oneof_enum_value = 4;
    MessageType oneof_message_value = 5;
    shark.NullValue oneof_null_value = 6;
  }
}

message TestMap {
  map<bool, int32> bool_map = 1;
  map<int32, int32> int32_map = 2;
  map<int64, int32> int64_map = 3;
  map<uint32, int32> uint32_map = 4;
  map<uint64, int32> uint64_map = 5;
  map<string, int32> string_map = 6;
}

message TestNestedMap {
  map<bool, int32> bool_map = 1;
  map<int32, int32> int32_map = 2;
  map<int64, int32> int64_map = 3;
  map<uint32, int32> uint32_map = 4;
  map<uint64, int32> uint64_map = 5;
  map<string, int32> string_map = 6;
  map<string, TestNestedMap> map_map = 7;
}

message TestStringMap {
  map<string, string> string_map = 1;
}

message TestWrapper {
  optional shark.BoolValue bool_value = 1;
  optional shark.Int32Value int32_value = 2;
  optional shark.Int64Value int64_value = 3;
  optional shark.UInt32Value uint32_value = 4;
  optional shark.UInt64Value uint64_value = 5;
  optional shark.FloatValue float_value = 6;
  optional shark.DoubleValue double_value = 7;
  optional shark.StringValue string_value = 8;
  optional shark.BytesValue bytes_value = 9;

  repeated shark.BoolValue repeated_bool_value = 11;
  repeated shark.Int32Value repeated_int32_value = 12;
  repeated shark.Int64Value repeated_int64_value = 13;
  repeated shark.UInt32Value repeated_uint32_value = 14;
  repeated shark.UInt64Value repeated_uint64_value = 15;
  repeated shark.FloatValue repeated_float_value = 16;
  repeated shark.DoubleValue repeated_double_value = 17;
  repeated shark.StringValue repeated_string_value = 18;
  repeated shark.BytesValue repeated_bytes_value = 19;
}

message TestTimestamp {
  optional shark.Timestamp value = 1;
  repeated shark.Timestamp repeated_value = 2;
}

message TestDuration {
  optional shark.Duration value = 1;
  repeated shark.Duration repeated_value = 2;
}

message TestFieldMask {
  optional shark.FieldMask value = 1;
}

message TestStruct {
  optional shark.Struct value = 1;
  repeated shark.Struct repeated_value = 2;
}

message TestAny {
  optional shark.Any value = 1;
  repeated shark.Any repeated_value = 2;
}

message TestValue {
  optional shark.Value value = 1;
  repeated shark.Value repeated_value = 2;
}

message TestListValue {
  optional shark.ListValue value = 1;
  repeated shark.ListValue repeated_value = 2;
}

message TestBoolValue {
  optional bool bool_value = 1;
  map<bool, int32> bool_map = 2;
}

message TestCustomJsonName {
  optional int32 value = 1 [json_name = "@value"];
}

message TestExtensions {
  optional .sharkbuf_unittest.TestAllExtensions extensions = 1;
}

message TestEnumValue {
  optional EnumType enum_value1 = 1;
  optional EnumType enum_value2 = 2;
  optional EnumType enum_value3 = 3;
}
