syntax = "proto2";

package shark;

enum class SharkType : uint8 {
  UNKNOWN = 0;
  BOOL = 1;
  INT8 = 2;
  UINT8 = 3;
  INT16 = 4;
  UINT16 = 5;
  INT32 = 6;
  UINT32 = 7;
  INT64 = 8;
  UINT64 = 9;
  FLOAT = 10;
  FLOAT16 = 11;
  FLOAT8 = 12;
  DOUBLE = 13;
  ENUM = 14;
  MESSAGE = 15;
  STRING = 16;
  BYTES = 17;

  FIXED32 = 18;
  FIXED64 = 19;
  SFIXED32 = 20;
  SFIXED64 = 21;
  SINT32 = 22;
  SINT64 = 23;
}

enum class SharkCppType : uint8 {
  BOOL = 1;
  INT8 = 2;
  UINT8 = 3;
  INT16 = 4;
  UINT16 = 5;
  INT32 = 6; // INT32, SINT32, SFIXED32
  UINT32 = 7; // UINT32, FIXED32
  INT64 = 8; // INT64, SINT64, SFIXED64
  UINT64 = 9; // UINT64, FIXED64
  FLOAT = 10;
  FLOAT16 = 11;
  FLOAT8 = 12;
  DOUBLE = 13;
  ENUM = 14;
  MESSAGE = 15;
  STRING = 16; // STRING, BYTES
};

// Whether a field is optional, required, or repeated.
enum FieldCardinality {
  // For fields with unknown cardinality.
  UNKNOWN = 0;
  // For optional fields.
  OPTIONAL = 1;
  // For required fields. Proto2 syntax only.
  REQUIRED = 2;
  // For list<fields>.
  REPEATED = 3;
}

// The syntax in which a protocol buffer element is defined.
enum Syntax {
  // Syntax `proto2`.
  SYNTAX_PROTO2 = 0;
  // Syntax `proto3`.
  SYNTAX_PROTO3 = 1;
}