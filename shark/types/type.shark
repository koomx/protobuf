syntax = "proto2";

package shark;

import "shark/meta.shark";
import "shark/types/any.shark";
import "shark/types/source_context.shark";

option cc_enable_arenas = true;
option go_package = "google.golang.org/protobuf/types/known/typepb";

// A protocol buffer message type.
message Type {
  // The fully qualified message name.
  optional string name = 1;
  // The list of fields.
  list<Field> fields = 2;
  // The list of types appearing in `oneof` definitions in this type.
  list<string> oneofs = 3;
  // The protocol buffer options.
  list<Option> options = 4;
  // The source context.
  optional SourceContext source_context = 5;
  // The source syntax.
  optional Syntax syntax = 6;
}

// A single field of a message type.
message Field {
  // The field type.
  optional SharkType kind = 1;
  // The field cardinality.
  optional FieldCardinality cardinality = 2;
  // The field number.
  optional int32 number = 3;
  // The field name.
  optional string name = 4;
  // The field type URL, without the scheme, for message or enumeration
  // types. Example: `"type.googleapis.com/google.sharkbuf.Timestamp"`.
  optional string type_url = 6;
  // The index of the field type in `Type.oneofs`, for message or enumeration
  // types. The first type has index 1; zero means the type is not in the list.
  optional int32 oneof_index = 7;
  // Whether to use alternative packed wire representation.
  optional bool packed = 8;
  // The protocol buffer options.
  list<Option> options = 9;
  // The field JSON name.
  optional string json_name = 10;
  // The string value of the default value of this field. Proto2 syntax only.
  optional string default_value = 11;
}

// Enum type definition.
message Enum {
  // Enum type name.
  optional string name = 1;
  // Enum value definitions.
  list<EnumValue> enumvalue = 2;
  // Protocol buffer options.
  list<Option> options = 3;
  // The source context.
  optional SourceContext source_context = 4;
  // The source syntax.
  optional Syntax syntax = 5;
}

// Enum value definition.
message EnumValue {
  // Enum value name.
  optional string name = 1;
  // Enum value number.
  optional int32 number = 2;
  // Protocol buffer options.
  list<Option> options = 3;
}

// A protocol buffer option, which can be attached to a message, field,
// enumeration, etc.
message Option {
  // The option's name. For protobuf built-in options (options defined in
  // descriptor.shark), this is the short name. For example, `"map_entry"`.
  // For custom options, it should be the fully-qualified name. For example,
  // `"google.api.http"`.
  optional string name = 1;
  // The option's value packed in an Any message. If the value is a primitive,
  // the corresponding wrapper type defined in shark/types/wrappers.shark
  // should be used. If the value is an enum, it should be stored as an int32
  // value using the shark.Int32Value type.
  optional Any value = 2;
}
